# From this directory, generate .env with python3 scripts/init-deploy.py; never commit it.
COMPOSE_PROJECT_NAME=liushao
BIND_ADDRESS=127.0.0.1
COMMUNITY_HTTP_PORT=8088
ADMIN_HTTP_PORT=8089
COMMUNITY_ORIGIN=http://localhost:8088
MYSQL_ROOT_PASSWORD=
ADMIN_DB_PASSWORD=
COMMUNITY_DB_PASSWORD=
REDIS_PASSWORD=
ADMIN_JWT_SECRET=
COMMUNITY_JWT_SECRET=
COMMUNITY_ADMIN_KEY=
# Enable only for the first start against an empty admin database.
BOOTSTRAP_ADMIN=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Email delivery (required to use email verification/password recovery).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS=true
