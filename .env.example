JAVA_HOME=/opt/java/jdk21
DB_URL=jdbc:mysql://localhost:3306/liushao_community?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=root
# Production must use a dedicated application DB user and a non-empty password.
DB_PASSWORD=
JWT_SECRET=
JWT_EXPIRE_SECONDS=86400
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Production requires a non-empty Redis password.
REDIS_DATABASE=0

# Default local profile imports .env.local; prod accepts explicit environment/config only.
# Containers default to prod. Set every required value above to a non-empty value.
# SERVER_PORT=8080
# SPRING_PROFILES_ACTIVE=prod
# JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75

# Community operations bridge: use the same independent random key in both backends.
COMMUNITY_ADMIN_KEY=
# Uploaded images are persistent application data.
UPLOAD_DIRECTORY=./data/uploads
# Email verification and password reset; use your SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS=true
